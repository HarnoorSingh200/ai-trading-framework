# --- Local runtime data -------------------------------------------------
data/
logs/
run/
*.db
*.db-wal
*.db-shm
*.sqlite

# Module 1's checked-in copies of exchange data (its constituent list, the
# holiday-list seed). Runtime data under those directories stays ignored.
