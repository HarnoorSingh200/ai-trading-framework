# Copy to .env (git-ignored) or export in your shell / OS secret store.
# Placeholder names only. Never commit real values.

# development | paper | live
TRADING_ENV=development

# Where the real secrets live. Outside this repository, always.
# FRAMEWORK_SECRETS_FILE=C:\Users\you\.trading-framework\secrets.env

# --- The day the framework works ----------------------------------------- #
# Operator policy, not exchange hours. Decisions run from the open to the
# decision close; nothing may stay open past the framework close. The bar that
# closes at the decision close is still answered (it is read a few seconds
# later), and the difference between the two closes is the holding time the
# last order of the day is allowed.
FRAMEWORK_DECISION_OPEN=09:30
FRAMEWORK_DECISION_CLOSE=14:30
FRAMEWORK_CLOSE=14:50
# How long after the decision close the last cycle's candle may still be
# answered (seconds).
FRAMEWORK_DECISION_GRACE_SECONDS=90

# --- The exchange's holiday list ------------------------------------------ #
# A local JSON list of NSE trading holidays, so an official closure never
# starts the trading day. Module 1 owns the list: it reads this file, refreshes
# it from NSE's holiday master when it is older than the refresh setting, and
# serves it through the session clock. The central process reads the same file
# when Module 1 cannot answer. Until the first refresh, the checked-in seed
# (module1/data/nse_holidays.json) is used.
FRAMEWORK_HOLIDAYS_FILE=data/holidays/nse.json
FRAMEWORK_HOLIDAYS_REFRESH_SECONDS=86400

# --- Telegram ------------------------------------------------------------ #
# The operator's line out: orders, fills, closes, failures. Both values belong
# in FRAMEWORK_SECRETS_FILE, never here; the placeholders are for reference.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Set to false to mute the notifier without removing the credentials.
TELEGRAM_ENABLED=true

# --- Logs ---------------------------------------------------------------- #
# One rotating file per process under this directory, stamped in IST.
FRAMEWORK_LOG_DIR=logs
# DEBUG | INFO | WARNING | ERROR
FRAMEWORK_LOG_LEVEL=INFO

# --- The runner (python -m runner) ---------------------------------------- #
# The central process: Module 1 and Module 4 start together, then Modules 3 and
# 2 start for the trading day once Module 1 is stable. It keeps running after the close - Module 1 keeps the last
# available data and Module 4 keeps the reports - and its control surface is
# what the site's Control tab reads.
FRAMEWORK_CONTROL_HOST=127.0.0.1
FRAMEWORK_CONTROL_PORT=5205
# How long Module 1 is given to stabilise before the rest is started, and the
# ceiling on that wait.
FRAMEWORK_STABILIZE_SECONDS=60
FRAMEWORK_STABILIZE_TIMEOUT_SECONDS=420
# The share of the universe that must carry computed indicators before the rest
# of the framework is started. Not all of it: a symbol whose history did not
# come back must not hold the morning hostage.
FRAMEWORK_INDICATOR_READY_FRACTION=0.9
# How long before the decision window the trading services (Modules 3 and 2)
# are started, so the book and the agent clocks are in place before the first
# candle of the day is decided.
FRAMEWORK_DAY_LEAD_SECONDS=300
# How long after the decision close the agent fleet may finish its last cycle,
# and how long after the framework close the services are given to settle.
FRAMEWORK_MODULE2_STOP_GRACE_SECONDS=60
FRAMEWORK_CLOSE_GRACE_SECONDS=20
# Health probing and restart policy.
FRAMEWORK_HEALTH_SECONDS=30
FRAMEWORK_RESTART_LIMIT=5
FRAMEWORK_RESTART_DELAY_SECONDS=5

# --- The machine's own shutdown (a scheduled VPS) ------------------------- #
# When true, after the framework's close the runner stops every remaining
# service, checks that each process is really gone, and only then runs the
# command below - the machine powers itself off. This is what lets a
# scheduled VPS cost nothing outside its hours. Off by default: a
# development machine must never power itself off by accident.
FRAMEWORK_SELF_SHUTDOWN=false
# Run as a command line, never through a shell, and it must work without a
# password (see the sudoers line in deploy/README.md). On a POSIX machine
# without sudo a plain `shutdown -h now` or `systemctl poweroff` will do.
FRAMEWORK_SHUTDOWN_COMMAND=sudo shutdown -h now

# --- Broker credentials (Zerodha) ----------------------------------------
# The web-session login needs these four; no browser and no daily approval.
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=
# Optional: paste a Kite Connect access token to skip the login entirely.
ZERODHA_ACCESS_TOKEN=

# --- Module 1 service ----------------------------------------------------
MODULE1_HOST=127.0.0.1
MODULE1_PORT=5201
# Seconds between full history refreshes of the universe.
MODULE1_REFRESH_SECONDS=60
# Trading sessions of daily candles to keep per symbol.
MODULE1_HISTORY_DAYS=10
# Set to false to serve stored history only, with no live websocket.
MODULE1_FEED_ENABLED=true
# The index the agents are compared against in the Reporting tab. It is a market
# fact, so Module 1 fetches it from the broker; Module 4 only mirrors it.
MODULE1_BENCHMARK_SYMBOL=NIFTY 50
MODULE1_BENCHMARK_DAYS=120
MODULE1_BENCHMARK_REFRESH_SECONDS=900

# --- Module 2 service (the agent engine) ---------------------------------
MODULE2_HOST=127.0.0.1
MODULE2_PORT=5202
# The runner and the UI talk to the control service here.
MODULE2_URL=http://127.0.0.1:5202
# Where Module 2 finds Module 1.
MODULE1_URL=http://127.0.0.1:5201
# Where a decided order is handed on to. Best-effort: Module 3 reconciles
# against Module 2's decision log, so a failed hand-over delays it, not loses it.
MODULE3_URL=http://127.0.0.1:5203
# Where agents are defined, and what they did. Git-ignored, under data/.
MODULE2_DATA_DIR=data/agents
# How long to wait for Module 1 to finish building the bar that just closed.
# This is a ceiling, not a sleep: the agent starts as soon as the book says the
# bar is done, which is usually about a second. (Was MODULE2_SETTLE_SECONDS,
# which was a flat sleep; that name still works as a fallback.)
MODULE2_BAR_TIMEOUT_SECONDS=12
# How much of the universe must have a finished bar before the agent starts.
# Not all of it: a stock that has not traded for a minute is legitimately short.
MODULE2_BAR_READY_FRACTION=0.9
# Start every defined agent when the control service comes up.
MODULE2_AUTOSTART=true
# Seconds after a bar closes before the agent reads it: the candle and its
# indicators need the first tick of the next minute to exist.
MODULE2_CANDLE_SETTLE_SECONDS=5

# --- The model an agent thinks with --------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. The key itself belongs in
# FRAMEWORK_SECRETS_FILE as DEEPSEEK_API_KEY, never here.
MODULE2_LLM_BASE_URL=https://api.deepseek.com
MODULE2_MODEL=deepseek-v4-flash
# How the model is spoken to. "auto" sends GPT models that are asked to reason
# to the Responses API - from GPT-5.4 on, the provider allows function calling
# on Chat Completions only when reasoning is off - and everything else to Chat
# Completions. "chat"/"responses" force one, for a gateway that implements only
# one of them.
MODULE2_LLM_API=auto
# The reasoning effort asked of a reasoning model. An agent's own definition may
# override it, and the effort is recorded with every decision it produced.
MODULE2_REASONING_EFFORT=high
# Agents whose model begins with "gpt-" use OPENAI_API_KEY when it is present.
# Without that key they fall back to MODULE2_LLM_BASE_URL and DEEPSEEK_API_KEY,
# which supports a gateway that serves GPT model names with one credential.
MODULE2_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Module 3 service (the order manager) --------------------------------
MODULE3_HOST=127.0.0.1
MODULE3_PORT=5203
# Where the decisions this module reconciles against come from. Prices come
# from MODULE1_URL, above.
MODULE2_URL=http://127.0.0.1:5202
# The order ledger: a checkpoint plus an append-only event log.
MODULE3_DATA_DIR=data/orders
# How often the holding clock is checked. A time exit does not wait for a tick.
MODULE3_SWEEP_SECONDS=1
# How often the watched prices are asked for outright, under the stream. A
# stock that never trades produces no stream frames at all.
MODULE3_POLL_SECONDS=15
# How often Module 2 is asked what it decided, and how far back it is worth
# looking. Anything older belongs to a session that is over.
MODULE3_RECONCILE_SECONDS=30
MODULE3_RECONCILE_MAX_AGE_MINUTES=120
# How far the market may move from the price a plan was built on before that
# plan is abandoned. The order expires instead of entering, and the entry it
# would have taken is the live price, not the planned one.
MODULE3_MAX_FILL_DRIFT_PCT=1.0
# A price older than this is not live enough to fill, or to exit, on.
MODULE3_STALE_PRICE_SECONDS=120

# --- Module 4 service (reporting) -----------------------------------------
MODULE4_HOST=127.0.0.1
MODULE4_PORT=5204
MODULE4_URL=http://127.0.0.1:5204
# Where the order book it archives lives. Module 2 also reads this.
MODULE3_URL=http://127.0.0.1:5203
# The long archive: every order ever seen, across every day.
MODULE4_DATA_DIR=data/history
# How often it asks Module 3 whether anything new has happened. Cheap: a
# finished day never changes, so a sync is usually one or two requests.
MODULE4_SYNC_SECONDS=30
# Where the agent engine's token-usage route lives. The logs belong to Module 2;
# Module 4 asks over this URL and never reads another module's files.
MODULE2_URL=http://127.0.0.1:5202
# The index the agents are compared against, read from Module 1's benchmark
# route. The notional is what a buy-and-hold line is drawn for (one agent's
# capital by default).
MODULE1_URL=http://127.0.0.1:5201
MODULE4_BENCHMARK_NOTIONAL=50000
# Optional durable mirror for the long archive. The local history file remains
# the fast read path; S3 is the copy that survives the scheduled VM.
# Set the bucket blank to keep Module 4 local-only.
MODULE4_S3_BUCKET=your-archive-bucket
MODULE4_S3_PREFIX="stock market v3"
MODULE4_S3_REGION=ap-southeast-1

# --- The central process's control surface ------------------------------- #
# Where the site forwards /central. Defaults to FRAMEWORK_CONTROL_PORT above.
CONTROL_URL=http://127.0.0.1:5205
